# ---------------------------------------------------------------------------
# Colbert Capital API — environment template
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info

# --- Database (Neon Postgres) ---------------------------------------------
# Use the pooled (…-pooler) host so a scaled-to-zero compute wakes without
# dropping the first request. `pgbouncer=true` keeps Prisma off prepared
# statements, which the pooler cannot serve.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15&pool_timeout=20

# --- CORS ------------------------------------------------------------------
# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain

# --- Proxies ---------------------------------------------------------------
# How many proxies sit in front of this app (Render/Vercel = 1). This is what
# decides which hop supplies the client address for rate limiting and audit
# records, so it must match the deployment and never be guessed per request.
TRUST_PROXY=1

# --- JWT -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- OTP -------------------------------------------------------------------
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_DEV_EXPOSE=false

# --- Passwords -------------------------------------------------------------
BCRYPT_ROUNDS=12

# --- Email -----------------------------------------------------------------
# MAIL_TRANSPORT=file keeps every rendered message on this machine under
# MAIL_SINK_DIR/outbox.jsonl and never contacts a provider. Use `resend` in
# production together with a verified MAIL_FROM domain.
MAIL_TRANSPORT=file
MAIL_SINK_DIR=./tmp/mail
RESEND_API_KEY=
MAIL_FROM="Colbert Capital <info@your-verified-domain>"
MAIL_REPLY_TO=info@your-verified-domain
MAIL_INQUIRIES_TO=info@your-verified-domain
MAIL_ENABLED=true

# --- Cloudflare Turnstile --------------------------------------------------
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=true

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

# --- Bootstrap admin (read by prisma/seed.js) ------------------------------
ADMIN_EMAIL=admin@your-domain
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Colbert
ADMIN_LAST_NAME=Operations
