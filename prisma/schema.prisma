// Colbert Capital — data model
// Postgres / Prisma. Money is stored as Decimal(18,2), never float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------- enums

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  PENDING // registered, email not verified
  ACTIVE
  SUSPENDED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  LOGIN
  RESET_PASSWORD
}

enum PlanStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PayoutFrequency {
  DAILY
  WEEKLY
  MONTHLY
  AT_MATURITY
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
}

enum InvestmentStatus {
  ACTIVE
  MATURED
  CLOSED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  EARNING
  PAYOUT
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  FAILED
}

enum SupportTopic {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  ACCOUNT
  OTHER
}

enum SupportStatus {
  OPEN
  PENDING
  RESOLVED
}

enum SupportPriority {
  NORMAL
  HIGH
}

enum AuthorRole {
  CLIENT
  ADMIN
}

enum PaymentMethodStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------- models

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  country         String?
  role            Role       @default(USER)
  status          UserStatus @default(PENDING)
  kycStatus       KycStatus  @default(NOT_STARTED)
  emailVerifiedAt DateTime?
  balance         Decimal    @default(0) @db.Decimal(18, 2)
  digitalBalance  Decimal    @default(0) @db.Decimal(18, 2)
  totalInvested   Decimal    @default(0) @db.Decimal(18, 2)
  totalEarnings   Decimal    @default(0) @db.Decimal(18, 2)
  lastLoginAt     DateTime?
  suspendedAt     DateTime?
  suspensionNote  String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  otpCodes     OtpCode[]
  sessions     Session[]
  investments  Investment[]
  marketPositions MarketPosition[]
  transactions Transaction[]
  threads      SupportThread[]
  auditLogs    AuditLog[]

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

model MarketPosition {
  id           String   @id @default(cuid())
  userId       String
  symbol       String
  name         String
  exchange     String?
  assetType    String?
  quantity     Decimal  @db.Decimal(18, 6)
  averagePrice Decimal  @db.Decimal(18, 4)
  costBasis    Decimal  @db.Decimal(18, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId, updatedAt])
  @@map("market_positions")
}

model OtpCode {
  id         String     @id @default(cuid())
  userId     String
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otp_codes")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Plan {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  summary         String
  description     String
  minAmount       Decimal         @db.Decimal(18, 2)
  maxAmount       Decimal         @db.Decimal(18, 2)
  roiPercent      Decimal         @db.Decimal(6, 2)
  durationDays    Int
  payoutFrequency PayoutFrequency @default(AT_MATURITY)
  riskLevel       RiskLevel       @default(MODERATE)
  status          PlanStatus      @default(ACTIVE)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  investments Investment[]

  @@index([status, sortOrder])
  @@map("plans")
}

model Investment {
  id             String           @id @default(cuid())
  reference      String           @unique
  userId         String
  planId         String
  amount         Decimal          @db.Decimal(18, 2)
  roiPercent     Decimal          @db.Decimal(6, 2)
  expectedReturn Decimal          @db.Decimal(18, 2)
  status         InvestmentStatus @default(ACTIVE)
  startedAt      DateTime         @default(now())
  maturesAt      DateTime
  closedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([status, maturesAt])
  @@map("investments")
}

model Transaction {
  id                 String            @id @default(cuid())
  reference          String            @unique
  userId             String
  type               TransactionType
  status             TransactionStatus @default(PENDING)
  amount             Decimal           @db.Decimal(18, 2)
  fee                Decimal           @default(0) @db.Decimal(18, 2)
  netAmount          Decimal           @db.Decimal(18, 2)
  currency           String            @default("USD")
  methodLabel        String?
  walletAddress      String?
  destinationName    String?
  destinationDetails String?
  note               String?
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("transactions")
}

model SupportThread {
  id         String          @id @default(cuid())
  reference  String          @unique
  userId     String?
  email      String
  clientName String
  subject    String
  topic      SupportTopic    @default(OTHER)
  priority   SupportPriority @default(NORMAL)
  status     SupportStatus   @default(OPEN)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user     User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([email])
  @@index([status, updatedAt])
  @@map("support_threads")
}

model SupportMessage {
  id         String     @id @default(cuid())
  threadId   String
  authorRole AuthorRole
  authorId   String?
  body       String
  createdAt  DateTime   @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("support_messages")
}

model PaymentMethod {
  id            String              @id @default(cuid())
  label         String
  kind          String // bank_transfer | crypto | card
  network       String?
  address       String?
  bankName      String?
  accountName   String?
  accountNumber String?
  swiftCode     String?
  instructions  String?
  status        PaymentMethodStatus @default(ACTIVE)
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, sortOrder])
  @@map("payment_methods")
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String
  inquiryType String
  region      String
  message     String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("inquiries")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorRole String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Atomic sequence generator for human-readable references
// (TKT-0001, INV-0001, TXN-0001). Incremented inside transactions.
model Counter {
  key   String @id
  value Int    @default(0)

  @@map("counters")
}
